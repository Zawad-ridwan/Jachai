{
  "manifest_version": 3,
  "name": "Jachai",
  "version": "0.6.0",
  "description": "AI-powered content safety filter and web inspection toolkit (English & Bangla).",
  "minimum_chrome_version": "120",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Jachai"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:4000/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}