# Copy this file to ".env" and fill in the values.

PORT=4000
PUBLIC_URL=http://localhost:4000

# At least 32 random characters. The server refuses to start otherwise.
JWT_SECRET=replace-me
JWT_EXPIRES_IN=7d

DB_PATH=./data/multishield.db

# Found on chrome://extensions after loading the extension (Developer mode on).
EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

# "mock"   = instant upgrades with no payment page (no Stripe account needed).
# "stripe" = a Stripe TEST-mode checkout page: pay with a test card, no real money moves.
#
# To use Stripe test mode:
#   1. Create a free account at https://dashboard.stripe.com/register
#      (you don't need to activate it or add a bank account for test mode).
#   2. Make sure "Test mode" is switched on (top right of the Dashboard).
#   3. Go to Developers > API keys and copy the "Secret key". It starts with sk_test_.
#   4. Paste it below and set BILLING_MODE=stripe, then restart the server.
# The server refuses to start with a live key (sk_live_...).
BILLING_MODE=mock
STRIPE_SECRET_KEY=
# Optional. Payments are confirmed when Stripe sends the buyer back, so you only
# need this if you also forward webhooks with the Stripe CLI:
#   stripe listen --forward-to localhost:4000/billing/webhook
# (it prints a whsec_... secret to paste here). STRIPE_PRICE_ID is no longer
# used: the price comes from the admin portal.
STRIPE_WEBHOOK_SECRET=
# Starting price of Pro, in whole taka per month. It's only used the first time
# the server starts; after that the admin changes the price in the admin portal
# (Finance & churn tab) and it's kept in the database. PRO_PRICE_CENTS is no
# longer used.
PRO_PRICE_TAKA=500

DAILY_LIMIT_REGULAR=50
DAILY_LIMIT_PAID=1000

# ---- AI services (Phase 5). Any check whose key is missing simply reports
# ---- "not set up yet" and charges nothing.

# AI-written text detection. https://sapling.ai (API settings page)
SAPLING_API_KEY=

# Hate speech / toxicity, and the safety part of image analysis (free endpoint).
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Emotion, fact-check reasoning, image reading and the cloud jargon simplifier.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Published fact-checks. A Google Cloud API key with the "Fact Check Tools API" enabled.
# Optional: without it, fake-news checks use the Gemini assessment only.
FACTCHECK_API_KEY=